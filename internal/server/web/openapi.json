{
  "openapi": "3.0.3",
  "info": {
    "title": "Private Marketplace Manager",
    "version": "2.0",
    "description": "Synchronous authenticated VSIX storage, API version 2. See /guide.html for deployment and usage. Unknown API paths return 404 and unsupported methods 405, both as JSON errors."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "marketplace_session"
      }
    },
    "responses": {}
  },
  "paths": {
    "/api/v2/status": {
      "get": {
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "Success: stored extension, version, package, and byte totals, records needing attention, startup inventory scan progress in `inventory`, and disk space in `storage`, and the library version limit in `limit`"
          },
          "401": {
            "description": "Invalid credential"
          }
        }
      }
    },
    "/api/v2/limit": {
      "get": {
        "summary": "The library version limit and the extensions with their own",
        "responses": {
          "200": {
            "description": "keep (0 keeps every version) and extensionLimits"
          },
          "401": {
            "description": "Invalid credential"
          }
        }
      },
      "put": {
        "summary": "Set the library version limit and delete older versions beyond it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "keep"
                ],
                "properties": {
                  "keep": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Newest versions kept per extension; 0 keeps every version"
                  },
                  "dryRun": {
                    "type": "boolean",
                    "description": "Report what the limit would delete"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied (or previewed): trimmed extensions, versions, packages, bytes, filesRemaining"
          },
          "400": {
            "description": "keep must be 0 or more"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/catalog/{id}/limit": {
      "put": {
        "summary": "Set one extension's version limit and delete older versions beyond it",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "keep"
                ],
                "properties": {
                  "keep": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Newest versions kept; 0 keeps every version; null follows the library default"
                  },
                  "dryRun": {
                    "type": "boolean",
                    "description": "Report what the limit would delete"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied (or previewed): keep, keepSource, trimmed"
          },
          "400": {
            "description": "keep must be null, 0, or more"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/catalog": {
      "get": {
        "summary": "Extensions grouped by ID with version, platform, package, size, and status counts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Part of an extension ID or display name"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "versions",
                "size",
                "updated"
              ]
            }
          },
          {
            "name": "attention",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Only extensions with missing, pending, or conflicting records"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Page size, default 100"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "deprecated": true,
            "schema": {
              "type": "integer"
            },
            "description": "Deprecated alias of pageSize; unrelated to version limits"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Unknown sort"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/catalog/{id}": {
      "get": {
        "summary": "One extension with its versions, newest first, and their platform packages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          },
          "404": {
            "description": "Extension not found"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/catalog/{id}/delete": {
      "post": {
        "summary": "Delete an extension's versions from disk, keeping them indexed as deleted",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "through": {
                    "type": "string",
                    "description": "Delete from the earliest version through this one (inclusive)"
                  },
                  "all": {
                    "type": "boolean",
                    "description": "Delete every version"
                  },
                  "dryRun": {
                    "type": "boolean",
                    "description": "Report what would be deleted"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted (or previewed): versions, packages, bytes, filesRemaining"
          },
          "400": {
            "description": "Send through or all"
          },
          "401": {
            "description": "Invalid credential"
          },
          "404": {
            "description": "Extension not found"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/extensions": {
      "get": {
        "summary": "Paginated package inventory",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Page size, default 100"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "deprecated": true,
            "schema": {
              "type": "integer"
            },
            "description": "Deprecated alias of pageSize; unrelated to version limits"
          }
        ]
      },
      "post": {
        "summary": "Validate and durably store raw VSIX bytes",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Package-Source",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical content already stored"
          },
          "201": {
            "description": "Validated file durably stored; removedVersions lists older versions the version limit deleted"
          },
          "409": {
            "description": "Identity or idempotency conflict, or `retention`: older than the extension's version limit"
          },
          "413": {
            "description": "Upload too large"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Busy"
          },
          "507": {
            "description": "Storage operation failed"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        }
      }
    },
    "/api/v2/extensions/check": {
      "post": {
        "summary": "Check up to 1000 package keys",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "keys"
                ],
                "properties": {
                  "keys": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/packages/download": {
      "get": {
        "summary": "Download original VSIX",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v2/uploads/by-key/{key}": {
      "get": {
        "summary": "Find an upload receipt",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After) or failed (`scan_failed`)"
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v2/audit-events": {
      "get": {
        "summary": "Audit events, newest first, with filters and paging",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          }
        },
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "stored",
                "rejected",
                "deleted_versions",
                "reconciled",
                "reconcile_failed",
                "conflict",
                "invalid_existing",
                "login"
              ]
            }
          },
          {
            "name": "actor",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "operator",
                "sync-token",
                "startup",
                "limit"
              ]
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Only events older than this event id"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ]
      }
    },
    "/api/v2/sync-runs": {
      "get": {
        "summary": "Recent sync reports",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          }
        }
      },
      "post": {
        "summary": "Save client-reported run summary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/v2/admin/reconcile": {
      "post": {
        "summary": "Reconcile the VSIX directory and durable inventory",
        "responses": {
          "200": {
            "description": "Reconciliation complete"
          },
          "401": {
            "description": "Invalid credential"
          },
          "500": {
            "description": "Storage or database reconciliation failed"
          },
          "503": {
            "description": "Startup inventory scan still running (`starting`; honor Retry-After). After a failed scan, this call retries it"
          }
        },
        "parameters": [
          {
            "name": "verify",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "full"
              ]
            },
            "description": "Rehash every file instead of only files whose size or modification time changed"
          }
        ]
      }
    },
    "/api/v2/me": {
      "get": {
        "summary": "Current session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          }
        }
      }
    },
    "/api/v2/logout": {
      "post": {
        "summary": "End browser session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid credential"
          }
        }
      }
    },
    "/api/v2/login": {
      "post": {
        "security": [],
        "summary": "Operator login; Origin must equal PUBLIC_URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session cookie and CSRF token"
          },
          "401": {
            "description": "Invalid password"
          },
          "403": {
            "description": "Wrong origin"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "security": [],
        "summary": "live health",
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "security": [],
        "summary": "ready health",
        "responses": {
          "200": {
            "description": "Serving. `status` is `starting` while the startup inventory scan runs, then `ready`"
          },
          "503": {
            "description": "Database, storage, or startup inventory scan failure"
          }
        }
      }
    }
  }
}
