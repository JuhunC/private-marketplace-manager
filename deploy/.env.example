# Copy this file to .env and change the values marked CHANGE ME.
# This example assumes a TLS reverse proxy on the same Linux host forwards
# https://marketplace-manager.corp.example.com to 127.0.0.1:8080.

COMPOSE_PROJECT_NAME=private-marketplace-manager
MANAGER_CONTAINER_NAME=private-marketplace-manager
MANAGER_IMAGE=ghcr.io/juhunc/private-marketplace-manager:0.2.0
RESTART_POLICY=unless-stopped

# CHANGE ME: exact browser-facing origin, with no trailing slash or path.
PUBLIC_URL=https://marketplace-manager.corp.example.com

# Keep the application HTTP port private to the host TLS reverse proxy.
MANAGER_BIND_ADDRESS=127.0.0.1
MANAGER_HOST_PORT=8080

# CHANGE ME: existing folder mounted at /data/extensions by the Microsoft
# Private Marketplace container, followed by a separate local state folder.
EXTENSIONS_HOST_DIR=/srv/vsmarketplace/extensions
STATE_HOST_DIR=/var/lib/private-marketplace-manager

# Must have read/write access to both host folders. Match your host ACL policy.
MANAGER_UID=10001
MANAGER_GID=10001

# Secret paths are relative to compose.yaml unless made absolute.
API_TOKEN_SECRET_FILE=./secrets/api-token.txt
ADMIN_PASSWORD_SECRET_FILE=./secrets/admin-password.txt

MAX_UPLOAD_BYTES=2147483648
CPU_LIMIT=2
MEMORY_LIMIT=1g
PIDS_LIMIT=128
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
