# Replace the server name and certificate paths for your internal PKI.
server {
    listen 80;
    server_name marketplace-manager.corp.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name marketplace-manager.corp.example.com;

    ssl_certificate     /etc/nginx/certs/marketplace-manager.crt;
    ssl_certificate_key /etc/nginx/certs/marketplace-manager.key;

    client_max_body_size 2g;
    client_body_timeout 30m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 30m;
        proxy_send_timeout 30m;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
